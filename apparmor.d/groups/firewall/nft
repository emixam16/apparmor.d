abi <abi/4.0>,

include <tunables/global>

@{exec_path} = @{sbin}/nft
profile nft @{exec_path} flags=(attach_disconnected) {
  include <abstractions/base>
  include <abstractions/nameservice-strict>

  capability net_admin,
  capability syslog,

  network (connect, create, setopt) inet6 dgram,
  network (connect, create, setopt) inet dgram,
  network netlink raw,

  ptrace (read),

  signal receive set=(cont term) peer=unshare,

  @{exec_path} mr,

  /usr/share/iproute2/{,**} r,

  /etc/iproute2/** r,
  /etc/nftables.conf r,
  /etc/nftables/{,**} r,

  @{PROC}/1/environ r,
  @{PROC}/cmdline r,
  @{PROC}/sys/kernel/osrelease r,
  @{PROC}/*/fd/ r,
  @{PROC}/*/net/netlink r,
  @{PROC}/*/stat r,


  owner @{HOME}/.nft.history rw,

  owner @{tmp}/elems-@{rand5}.nft r,
  owner @{tmp}/ruleset-*.nft r,
  owner @{tmp}/spoofcheck-* r,

  owner /usr/share/terminfo/** r,

  include if exists <local/nft>
}

# vim:syntax=apparmor
