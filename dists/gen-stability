"""
Generate dists/stability.json by classifying every source profile:

  stable    has its own integration test and ships in enforce (not complain).
  disabled  listed in dists/ignore.
  testing   everything else.

Output is committed and shipped as-is; --check gates drift in CI.
"""

import glob
import json
import os
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
PROFILES = os.path.join(ROOT, "apparmor.d")
STABILITY = os.path.join(ROOT, "dists", "stability.json")


def source_profiles():
    names = set()
    for base in glob.glob(f"{PROFILES}/groups/*") + glob.glob(f"{PROFILES}/profiles-*"):
        for _, _, files in os.walk(base):
            names.update(files)
    return names


def complain_flagged():
    out = set()
    with open(os.path.join(ROOT, "dists", "flags", "main.flags")) as f:
        for line in f:
            parts = line.split("#", 1)[0].split()
            if len(parts) >= 2 and parts[1] == "complain":
                out.add(parts[0])
    return out


def ignored(profiles):
    out = set()
    with open(os.path.join(ROOT, "dists", "ignore", "main.ignore")) as f:
        for line in f:
            entry = line.split("#", 1)[0].strip()
            if not entry:
                continue
            full = os.path.join(ROOT, entry)
            if os.path.isdir(full):
                for _, _, files in os.walk(full):
                    out.update(files)
            else:
                out.add(os.path.basename(entry))
    return out & profiles


def tested(profiles):
    """Profiles with their own <name>.bats anywhere under tests/integration."""
    bats = glob.glob(os.path.join(ROOT, "tests", "integration", "**", "*.bats"), recursive=True)
    return {os.path.basename(b)[:-len(".bats")] for b in bats} & profiles


def classify():
    profiles = source_profiles()
    disabled = ignored(profiles)
    stable = (tested(profiles) - complain_flagged()) - disabled
    testing = profiles - stable - disabled
    return {
        "stable": sorted(stable),
        "testing": sorted(testing),
        "disabled": sorted(disabled),
    }


SCHEMA = 1  # bump on shape changes


def render(classes):
    data = {"version": SCHEMA,
            "_comment": "Generated by dists/gen-stability -- do not edit by hand.",
            **classes}
    return json.dumps(data, indent=1) + "\n"


def main(argv=None):
    argv = argv if argv is not None else sys.argv[1:]
    classes = classify()
    content = render(classes)
    if "--check" in argv:
        current = ""
        if os.path.exists(STABILITY):
            with open(STABILITY) as f:
                current = f.read()
        if current != content:
            sys.stderr.write("dists/stability.json is stale; run dists/gen-stability\n")
            return 1
        print("dists/stability.json up to date")
        return 0
    with open(STABILITY, "w") as f:
        f.write(content)
    print("wrote %s: %d stable, %d testing, %d disabled"
          % (STABILITY, len(classes["stable"]), len(classes["testing"]), len(classes["disabled"])))
    return 0


if __name__ == "__main__":
    sys.exit(main())
