abi <abi/4.0>,

include <tunables/global>

@{exec_path} = @{lib}/flatpak-oci-authenticator
profile flatpak-oci-authenticator @{exec_path} {
  include <abstractions/base>
  include <abstractions/bus-session>

  #aa:dbus own bus=session name=org.flatpak.Authenticator.Oci

  @{exec_path} mr,
  network (connect) inet stream peer=(ip=127.0.0.1),
  network (create, setopt) inet stream,
  network (getattr, getopt) inet stream ip=127.0.0.1,
  network (send, receive) inet stream ip=127.0.0.1 peer=(ip=127.0.0.1),

  /var/tmp r,

  include if exists <local/flatpak-oci-authenticator>
}

# vim:syntax=apparmor
