abi <abi/4.0>,

include <tunables/global>

@{exec_path} = @{bin}/ssh
profile ssh @{exec_path} {
  include <abstractions/base>
  include <abstractions/consoles>
  include <abstractions/devices-u2f>
  include <abstractions/devices-usb>
  include <abstractions/kerberosclient>
  include <abstractions/nameservice-strict>

  network inet stream,
  network inet6 stream,
  network inet dgram,
  network inet6 dgram,
  network netlink raw,

  signal receive set=term peer=gnome-keyring-daemon,
  signal send set=hup peer=unconfined,

  @{exec_path} mrix,

  unix (receive, send) type=stream,

  @{bin}/@{shells}     rUx,
  @{bin}/ssh.hmac      r,
  @{bin}/grep          mrix,
  @{bin}/cat           mrix,

  @{lib}/{,ssh/}ssh-sk-helper rix,
  @{lib}/locale/* r,
  @{lib}/openssh/ssh-sk-helper mrix,

  @{lib}/@{multiarch}/gconv/gconv-modules.cache r,
  @{lib}/@{multiarch}/libcap.so.* mr,
  @{lib}/@{multiarch}/libcbor.so.* mr,
  @{lib}/@{multiarch}/libcrypto.so.* mr,
  @{lib}/@{multiarch}/libfido2.so.* mr,
  @{lib}/@{multiarch}/libgcc_s.so.* mr,
  @{lib}/@{multiarch}/libm.so.* mr,
  @{lib}/@{multiarch}/libpcre*.so.* mr,
  @{lib}/@{multiarch}/libselinux.so.* mr,
  @{lib}/@{multiarch}/libudev.so.* mr,
  @{lib}/@{multiarch}/libz.so.* mr,
  @{lib}/@{multiarch}/libzstd.so.* mr,


  @{etc_ro}/ssh/ssh_config r,
  @{etc_ro}/ssh/ssh_config.d/{,*} r,
  @{etc_ro}/ssh/sshd_config r,
  @{etc_ro}/ssh/sshd_config.d/{,*} r,
  /etc/machine-id r,
  /etc/gss/mech.d/{,*} r,

  owner @{HOME}/@{XDG_SSH_DIR}/{,*} r,
  owner @{HOME}/@{XDG_SSH_DIR}/known_hosts{,.*} rwl,
  owner @{HOME}/@{XDG_SSH_DIR}/ssh_control_*_*_* wl,
  owner @{HOME}/@{run}/gvfsd-sftp/@{hex}.@{hex} rw,
  owner @{HOME}/@{run}/gvfsd-sftp/@{hex} wl,

  owner @{user_projects_dirs}/**/ssh/{,*} r,
  owner @{user_projects_dirs}/**/config r,

  owner @{tmp}/krb5cc_* rwk,

  owner @{run}/user/@{uid}/gcr/ssh rw, #  gcr-ssh-agent socket (i.e. Gnome only)
  owner @{run}/user/@{uid}/gvfsd-sftp/@{hex} rwl -> @{run}/user/@{uid}/gvfsd-sftp/@{hex}.@{rand},
  owner @{run}/user/@{uid}/gvfsd-sftp/@{hex}.@{rand} rwl -> @{run}/user/@{uid}/gvfsd-sftp/@{hex}.@{rand},
  owner @{run}/user/@{uid}/keyring/ssh rw,
  owner @{run}/user/@{uid}/openssh_agent rw,

  owner @{PROC}/@{pid}/loginuid r,
  owner @{PROC}/@{pid}/fd/ r,
  @{PROC}/filesystems r,

  #aa:only test
  owner @{tmp}/ssh-@{rand10}/{,agent.@{int}} rw,
  owner @{tmp}/openssh-*/ctl-sock{,.*} rwl,

  include if exists <local/ssh>
}

# vim:syntax=apparmor
