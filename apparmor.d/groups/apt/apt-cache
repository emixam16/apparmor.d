abi <abi/4.0>,

include <tunables/global>

@{exec_path} = @{bin}/apt-cache
profile apt-cache @{exec_path} {
  include <abstractions/base>
  include <abstractions/apt>
  include <abstractions/consoles>

  @{exec_path} mr,

  @{bin}/dpkg mrPx -> child-dpkg,

  @{bin}/dash mrix,
  @{bin}/faked-sysv mrix,
  @{bin}/fakeroot-sysv mrix,
  @{bin}/getopt mrix,
  @{bin}/gnutrue mrix,
  @{bin}/sed mrix,
  @{bin}/cut mrix,
  @{bin}/false mrix,

  owner /usr/share/dpkg/varianttable r,
  owner @{tmp}/tmp.*{,/} r,

  @{lib}/@{multiarch}/libgcc_s.so.* mr,
  @{lib}/@{multiarch}/libm.so.* mr,
  @{lib}/@{multiarch}/libpcre*-*.so.* mr,
  @{lib}/@{multiarch}/libselinux.so.* mr,


  /var/lib/dbus/machine-id r,
  /etc/machine-id r,

  /var/lib/dpkg/** r,
  /var/lib/dpkg/lock{,-frontend} rwk,

  /var/cache/apt/ r,
  /var/cache/apt/** rwk,

  owner @{PROC}/@{pid}/fd/ r,

  include if exists <local/apt-cache>
}

# vim:syntax=apparmor
